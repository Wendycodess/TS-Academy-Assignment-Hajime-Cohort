  "insights": {
    "key_findings": [
      "Fleet logged 85,410 trips over 3 years, averaging 1430 miles/trip at 6.50 MPG.",
      "Trip volume held remarkably stable YoY (2022:28,589 \u2192 2024:28,656, \u00b11.7%), indicating mature, demand-constrained operations.",
      "Safety incident rate ticked up in 2024 to 2.09 per 1,000 trips (from 1.96 in 2022) \u2014 a 6.6% cumulative increase.",
      "Preventable incidents account for 34.1% of total claim exposure ($904,476 of $2,653,172) \u2014 directly actionable through driver training and coaching.",
      "1,680 trips (2.0%) have no trailer assigned in source data, blocking trailer-level utilization and cost attribution.",
      "Chicago, Seattle, and Memphis concentrate $678,876 in claims (25.6% of total) \u2014 clear geographic clustering."
    ],
    "recommendations": [
      {
        "priority": "HIGH",
        "title": "Close the trailer-assignment data gap",
        "impact": "Restores trailer-level utilization, depreciation, and cost-per-mile attribution for ~2% of fleet activity (1,680 trips/yr).",
        "action": "Mandate trailer_id capture at dispatch in the TMS; add a validation rule that blocks dispatch confirmation when trailer_id is blank; backfill the 1,680 historical rows via TMS audit log.",
        "risks": "Driver pushback if dispatch flow slows; mitigate with a 30-day soft-enforcement window.",
        "validation": "Re-run DQ checks monthly; target <0.5% blank trailer_id within 60 days."
      },
      {
        "priority": "HIGH",
        "title": "Targeted safety intervention in top-3 claim cities",
        "impact": "Chicago, Seattle, Memphis drive >26.0% of claim dollars; a 25% reduction would avoid ~$169,719/yr.",
        "action": "Deploy city-specific driver coaching (weather, dock, traffic patterns); add telematics-based hard-braking alerts on routes into these cities; review top-3 repeat-offender drivers.",
        "risks": "Coaching cost (~$15k); potential driver turnover if perceived as punitive. Frame as coaching, not discipline.",
        "validation": "Compare quarterly claim run-rate in target cities vs. same quarter prior year."
      },
      {
        "priority": "MEDIUM",
        "title": "Reduce preventable incidents (one-third of claim $, fully controllable)",
        "impact": "Preventable incidents = 34.1% of $2,653,172 total exposure. Even a 10% reduction avoids ~$90,448.",
        "action": "Launch a quarterly safety-scorecard program (preventable incidents, at-fault, injuries); tie a meaningful but fair fraction of driver bonus to scorecard; refresh defensive-driving curriculum.",
        "risks": "Bonus structure changes require HR/Legal review; may take 2 quarters to show effect.",
        "validation": "Track preventable incident count and $ quarter-over-quarter; benchmark against industry CSA scores."
      },
      {
        "priority": "MEDIUM",
        "title": "Investigate Refrigerated vs Dry Van MPG gap",
        "impact": "Refrigerated units average 6.499 MPG vs 6.505 MPG for Dry Van \u2014 reefer fuel burn is a known driver but the gap should be quantified and trended.",
        "action": "Separate reefer fuel from tractor fuel in reporting; set type-specific MPG targets; pilot auxiliary-electric reefer units on 5 highest-mileage reefer trailers.",
        "risks": "Capital cost of pilot (~$50k); technology maturity risk. Start with a 90-day pilot.",
        "validation": "Compare pilot MPG vs. control group over same routes; ROI gate before fleet rollout."
